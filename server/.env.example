# Copia este archivo a .env y ajusta los valores.
# NO subas el archivo .env al repositorio (debe estar en .gitignore).
# En producción: usa HTTPS, JWT_SECRET obligatorio (mín. 16 caracteres).

NODE_ENV=development
PORT=5000
TZ=America/Mexico_City

# Obligatorio en producción
JWT_SECRET=tu-clave-secreta-muy-segura-minimo-16-caracteres
JWT_EXPIRES_IN=24h

# Obligatorio en producción (NO uses *): orígenes del panel/API permitidos por CORS (coma)
# Ejemplo mismo host: ALLOWED_ORIGINS=https://tudominio.com
ALLOWED_ORIGINS=http://localhost:5173

# Opcional: tamaño máximo del body JSON (por defecto 2 mb; backup/import permite 300 mb solo en esa ruta)
# API_JSON_BODY_LIMIT=2mb
# API_BACKUP_IMPORT_JSON_LIMIT=300mb

# Producción: deshabilitado por seguridad salvo ENABLE_REMOTE_UPDATE=true (ejecuta git pull, npm, build y reinicia)
# ENABLE_REMOTE_UPDATE=

# Opcionales: backup por cron y agente de tráfico (si se definen en prod, mín. 16 caracteres)
# En producción usar cabecera X-Backup-Secret (no ?secret= en la URL).
# BACKUP_CRON_SECRET=
# TRAFFIC_AGENT_SECRET=

# Chat IA en portal del cliente
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Stripe (pagos en línea: tarjeta y OXXO en el portal del cliente)
# Para PAGOS REALES usa claves LIVE (sk_live_, whsec_ del webhook Live).
# Para pruebas usa claves TEST (sk_test_, webhook de prueba). Ver PAGOS_STRIPE_LIVE.md
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_... (opcional, para pago embebido)

# Otros
# PUBLIC_URL=https://tudominio.com
# AUDIT_RETENTION_MONTHS=12
# TRAFFIC_MONITOR_INTERVAL=60
